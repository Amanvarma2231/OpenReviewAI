# OpenReviewAI Configuration Environment Variables

# Ollama Host (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default Models (Can be Gemma, Mistral, Bonsai, Qwen, DeepSeek)
DEFAULT_GENERATOR_MODEL=qwen2.5-coder:1.5b
DEFAULT_REVIEWER_MODEL=mistral:latest
DEFAULT_VALIDATOR_MODEL=deepseek-coder:latest

# Hugging Face Inference API (Optional, for HF hosted open models)
HUGGINGFACEHUB_API_TOKEN=

# OpenAI-Compatible API (Optional, for Groq / DeepSeek / vLLM / LM Studio / Together)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Max Iterations / Retry Limit
DEFAULT_MAX_RETRIES=3
SANDBOX_TIMEOUT_SECONDS=5
